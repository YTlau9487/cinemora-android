<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/main"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#FFFFFF"
tools:context=".OrderDetailActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="#1F1F1F"
            app:title="@string/order_details"
            app:titleCentered="false"
            app:titleMarginStart="16dp"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:titleTextColor="#333333"
            app:subtitle="Order #Order Num • Date"
            app:subtitleTextColor="#9E9E9E"
            app:subtitleTextAppearance="10sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="40dp">

            <LinearLayout
                android:id="@+id/formContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/purchased_items"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="4"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/OrderSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#EEEEEE"
                    app:cardBackgroundColor="#FFFFFF">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/OrderSummaryLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/order_summary"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#111111"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:id="@+id/SubtotalLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/subtotal"
                            android:textSize="15sp"
                            android:textColor="#888888"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/OrderSummaryLabel"
                            app:layout_constraintEnd_toStartOf="@id/SubtotalValue"/>

                        <TextView
                            android:id="@+id/SubtotalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HKD 203"
                            android:textSize="15sp"
                            android:textColor="#111111"
                            app:layout_constraintBaseline_toBaselineOf="@id/SubtotalLabel"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <TextView
                            android:id="@+id/DiscountLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/discount"
                            android:textSize="15sp"
                            android:textColor="#888888"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/SubtotalLabel"
                            app:layout_constraintEnd_toStartOf="@id/DiscountValue"/>

                        <TextView
                            android:id="@+id/DiscountValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="- HKD 30"
                            android:textSize="15sp"
                            android:textColor="#2ECC71"
                            app:layout_constraintBaseline_toBaselineOf="@id/DiscountLabel"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <View
                            android:id="@+id/dividerSummary"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="#F0F0F0"
                            app:layout_constraintTop_toBottomOf="@id/DiscountLabel"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <TextView
                            android:id="@+id/TotalLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/total"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:textColor="#111111"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/dividerSummary"
                            app:layout_constraintEnd_toStartOf="@id/TotalValue"/>

                        <TextView
                            android:id="@+id/TotalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HKD 173"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:textColor="#12BFE6"
                            app:layout_constraintBaseline_toBaselineOf="@id/TotalLabel"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCredits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#EEEEEE"
                    app:cardBackgroundColor="#FFFFFF">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/CreditsLable"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/credits"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#111111"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:id="@+id/CreditsBeforeLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/credits_before"
                            android:textSize="15sp"
                            android:textColor="#888888"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/CreditsLable"
                            app:layout_constraintEnd_toStartOf="@id/CreditsBeforeValue"/>

                        <TextView
                            android:id="@+id/CreditsBeforeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="120 pts"
                            android:textSize="15sp"
                            android:textColor="#111111"
                            app:layout_constraintBaseline_toBaselineOf="@id/CreditsBeforeLabel"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <TextView
                            android:id="@+id/CreditsUsedLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/amount_used"
                            android:textSize="15sp"
                            android:textColor="#888888"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/CreditsBeforeValue"
                            app:layout_constraintEnd_toStartOf="@id/CreditsUsedValue"/>

                        <TextView
                            android:id="@+id/CreditsUsedValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="- 173 pts"
                            android:textSize="15sp"
                            android:textColor="#FF5A5A"
                            app:layout_constraintBaseline_toBaselineOf="@id/CreditsUsedLabel"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <View
                            android:id="@+id/dividerCredits"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="#F0F0F0"
                            app:layout_constraintTop_toBottomOf="@id/CreditsUsedLabel"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <TextView
                            android:id="@+id/CreditsAfterLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/credits_after"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:textColor="#111111"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/dividerCredits"
                            app:layout_constraintEnd_toStartOf="@id/CreditsAfterValue"/>

                        <TextView
                            android:id="@+id/CreditsAfterValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-53 pts"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:textColor="#2ECC71"
                            app:layout_constraintBaseline_toBaselineOf="@id/CreditsAfterLabel"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOrderStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#BFEFF7"
                    app:cardBackgroundColor="#EAFBFF">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp">

                        <View
                            android:id="@+id/viewStatusBall"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_status_ball"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@id/StatusTitle"
                            app:layout_constraintBottom_toBottomOf="@id/StatusTitle" />

                        <TextView
                            android:id="@+id/StatusTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Order Completed"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="#12BFE6"
                            app:layout_constraintStart_toEndOf="@id/viewStatusBall"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:id="@+id/StatusDesc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Your order has been successfully processed"
                            android:textSize="13sp"
                            android:textColor="#7AAAB4"
                            app:layout_constraintStart_toStartOf="@id/StatusTitle"
                            app:layout_constraintTop_toBottomOf="@id/StatusTitle"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>