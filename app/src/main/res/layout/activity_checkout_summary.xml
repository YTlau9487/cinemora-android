<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".CheckoutSummaryActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="40dp">

            <LinearLayout
                android:id="@+id/successHintLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/imgSuccess"
                    android:layout_width="80dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="24dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_tick_badge" />

                <TextView
                    android:id="@+id/Title"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="Purchase Successful!"
                    android:textColor="#111111"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Your movies are ready to watch"
                    android:textColor="#8A8A8A"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/OrderSummaryLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/successHintLayout">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/OrderSummaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EEEEEE"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/OrderNumLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/order_number"
                            android:textColor="#888888"
                            android:textSize="15sp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/OrderNumValue"/>

                        <TextView
                            android:id="@+id/OrderNumValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="#OrderNum"
                            android:textColor="#111111"
                            android:textSize="15sp"
                            app:layout_constraintBaseline_toBaselineOf="@id/OrderNumLabel"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:id="@+id/DateLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/date"
                            android:textColor="#888888"
                            android:textSize="15sp"
                            app:layout_constraintEnd_toStartOf="@id/DateValue"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/OrderNumLabel" />

                        <TextView
                            android:id="@+id/DateValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DD MM YY"
                            android:textColor="#111111"
                            android:textSize="15sp"
                            app:layout_constraintBaseline_toBaselineOf="@id/DateLabel"
                            app:layout_constraintEnd_toEndOf="parent" />


                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/PurchasedItemsLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/OrderSummaryLayout">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/PurchasedItemsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EEEEEE"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/PurchasedItems"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/purchased_items"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#111111"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvPurchasedItems"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:nestedScrollingEnabled="false"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/PurchasedItems"
                            tools:itemCount="3" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/PaymentSummaryLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/PurchasedItemsLayout">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/PaymentSummaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EEEEEE"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/PaymentSummaryLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/order_summary"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#111111"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:id="@+id/SubtotalLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/subtotal"
                            android:textSize="15sp"
                            android:textColor="#888888"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/PaymentSummaryLabel"
                            app:layout_constraintEnd_toStartOf="@id/SubtotalValue"/>

                        <TextView
                            android:id="@+id/SubtotalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HKD 203"
                            android:textSize="15sp"
                            android:textColor="#111111"
                            app:layout_constraintBaseline_toBaselineOf="@id/SubtotalLabel"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <TextView
                            android:id="@+id/DiscountLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/discount"
                            android:textSize="15sp"
                            android:textColor="#888888"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/SubtotalLabel"
                            app:layout_constraintEnd_toStartOf="@id/DiscountValue"/>

                        <TextView
                            android:id="@+id/DiscountValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="- HKD 30"
                            android:textSize="15sp"
                            android:textColor="#2ECC71"
                            app:layout_constraintBaseline_toBaselineOf="@id/DiscountLabel"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <View
                            android:id="@+id/dividerSummary"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="#F0F0F0"
                            app:layout_constraintTop_toBottomOf="@id/DiscountLabel"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <TextView
                            android:id="@+id/TotalLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/total"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:textColor="#111111"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/dividerSummary"
                            app:layout_constraintEnd_toStartOf="@id/TotalValue"/>

                        <TextView
                            android:id="@+id/TotalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HKD 173"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:textColor="#12CFC2"
                            app:layout_constraintBaseline_toBaselineOf="@id/TotalLabel"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/CreditsDetailLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/PaymentSummaryLayout">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/CreditsDetailCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#E8F9F6"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EEEEEE"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/CreditsUsedLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/credits_used"
                            android:textColor="#888888"
                            android:textSize="15sp"
                            app:layout_constraintEnd_toStartOf="@id/CreditsUsedValue"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/CreditsUsedValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="173 pts"
                            android:textSize="15sp"
                            android:textColor="#111111"
                            app:layout_constraintBaseline_toBaselineOf="@id/CreditsUsedLabel"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <TextView
                            android:id="@+id/RemainingCreditsLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/remaining_credits"
                            android:textStyle="bold"
                            android:textSize="17sp"
                            android:textColor="#111111"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/CreditsUsedLabel"
                            app:layout_constraintEnd_toStartOf="@id/RemainingCreditsValue"/>

                        <TextView
                            android:id="@+id/RemainingCreditsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-53 pts"
                            android:textSize="17sp"
                            android:textColor="#2ECC71"
                            app:layout_constraintBaseline_toBaselineOf="@id/RemainingCreditsLabel"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ActionButtonsLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/CreditsDetailLayout">

                <!-- Button 1: Filled -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewMyMovies"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="View My Movies"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#12CFC2"
                    app:cornerRadius="28dp"
                    app:elevation="0dp"
                    app:rippleColor="#3312CFC2"
                    app:strokeWidth="0dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackToHome"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Back to Home"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#12CFC2"
                    app:cornerRadius="28dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#12CFC2"
                    android:backgroundTint="#FFFFFF"
                    app:elevation="0dp"
                    app:rippleColor="#1A12CFC2" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>